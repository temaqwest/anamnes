DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
# Port published on 127.0.0.1 only
ANAMNES_PORT=5186
# Fill these for a trusted HTTPS reverse proxy on the same host:
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,anamnes.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://anamnes.example.com
# DJANGO_SECURE_COOKIES=1

# Invite-only sign-up. Set the real HTTPS origin and a working SMTP provider before enabling.
ANAMNES_SIGNUP_ENABLED=0
# ANAMNES_PUBLIC_URL=https://anamnes.example.com
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USE_TLS=1
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_DEFAULT_FROM_EMAIL=Anamnes <no-reply@anamnes.example.com>
